
(() => {
  const D = window.TRADE_DATA;
  if (!D || !D.concepts) return;

  const byId = Object.fromEntries(D.concepts.map(c => [c.id, c]));

  // ---- HVAC: refrigerant transition (2020s field reality) ----
  // R-22 is long phaseout for new equipment. R-410A is still common in existing systems.
  // Newer equipment is moving to lower-GWP options including mildly flammable A2L refrigerants (R-32, R-454B, etc.).
  // Technicians need recovery certification, correct gauges/hoses, and awareness of A2L handling differences.
  const refCycle = byId["refrigeration-cycle"] || byId["pressure-temperature"] || byId["compressor"];
  if (byId["compressor"]) {
    const c = byId["compressor"];
    c.oneLine = c.oneLine || "Raises refrigerant pressure and temperature so heat can be rejected outdoors.";
    if (!/A2L|R-410|lower-GWP|recovery/.test(JSON.stringify(c))) {
      c.deep = c.deep || {};
      c.deep.fieldScenario = c.deep.fieldScenario || c.fieldScenario || "";
      const note = " Field note (2020s): many existing systems still run R-410A; new equipment is shifting toward lower-GWP refrigerants, including A2L mildly flammable blends. Recovery, correct tools, and manufacturer procedures apply — do not mix refrigerants or treat every cylinder the same.";
      if (c.deep.fieldScenario && !c.deep.fieldScenario.includes("A2L")) {
        c.deep.fieldScenario = c.deep.fieldScenario + note;
      } else if (!c.deep.fieldScenario) {
        c.deep.fieldScenario = note.trim();
      }
    }
  }
  if (byId["metering-device"]) {
    const c = byId["metering-device"];
    c.deep = c.deep || {};
    if (!/TXV|piston|orifice|A2L/.test(c.deep.recognize || "")) {
      c.deep.recognize = "Look for a TXV bulb/equalizer, piston, or fixed orifice at the evaporator inlet. Design matches the refrigerant and coil.";
      c.deep.verify = "Superheat (TXV systems) and subcooling (often used with fixed metering) are the usual charge checks — only with the correct P-T chart for that refrigerant.";
    }
  }
  if (byId["superheat"]) {
    const c = byId["superheat"];
    c.deep = c.deep || {};
    c.deep.verify = (c.deep.verify || "") + (c.deep.verify && c.deep.verify.includes("P-T") ? "" : " Always use the pressure–temperature relationship for the actual refrigerant in the system.");
  }

  // ---- Plumbing: lead-free and modern materials ----
  if (byId["potable-water"]) {
    const c = byId["potable-water"];
    c.deep = c.deep || {};
    if (!/lead-free|Lead-Free|NSF/.test(JSON.stringify(c.deep))) {
      c.deep.recognize = "Potable (drinking) water systems require materials and fittings that meet current lead-free requirements for the jurisdiction. Older leaded solder and non-compliant brass are not acceptable on new potable work.";
      c.deep.verify = "Confirm product markings (e.g., lead-free / NSF) on valves and fittings used on potable lines. Do not reuse scrap fittings of unknown compliance on drinking-water lines.";
    }
  }
  if (byId["pex"]) {
    const c = byId["pex"];
    c.deep = c.deep || {};
    c.deep.recognize = c.deep.recognize || "Cross-linked polyethylene supply tubing. Common with crimp, clamp, expansion, or push-fit connections and often used in manifold (home-run) layouts.";
    c.deep.verify = c.deep.verify || "Match ring/tool type to the tubing standard. Support and bend radius matter. Transition to metal with approved fittings — do not invent adapters.";
  }
  if (byId["copper-tube"]) {
    const c = byId["copper-tube"];
    c.deep = c.deep || {};
    if (!/lead-free solder|lead-free/.test(JSON.stringify(c.deep))) {
      c.deep.verify = (c.deep.verify || "Use approved joining methods.") + " Potable copper joints use lead-free solder or other approved methods — traditional leaded solder is not for drinking-water systems.";
    }
  }
  if (byId["backflow-prevention"]) {
    const c = byId["backflow-prevention"];
    c.deep = c.deep || {};
    c.deep.recognize = c.deep.recognize || "Devices and assemblies that stop contaminated water from reversing into the potable supply (e.g., vacuum breakers, check valves, reduced-pressure assemblies depending on hazard).";
    c.deep.verify = c.deep.verify || "Installation height, orientation, and test ports matter. High-hazard applications often require testable assemblies and periodic testing under local code.";
  }

  // ---- Electrical: arc-flash / modern measurement safety ----
  if (byId["arc-flash"]) {
    const c = byId["arc-flash"];
    c.deep = c.deep || {};
    if (!/NFPA|70E|incident energy/.test(JSON.stringify(c.deep))) {
      c.deep.recognize = "An arc-flash hazard is the release of energy from an arcing fault. Labels, approach boundaries, and required PPE are determined by the facility's arc-flash study and standards such as NFPA 70E — not by guesswork.";
      c.deep.verify = "Before energized work: confirm the hazard assessment, wear the required PPE, and prefer de-energized work when the task allows. Meter category ratings (CAT) must match the electrical environment.";
    }
  }
  if (byId["multimeter"]) {
    const c = byId["multimeter"];
    c.deep = c.deep || {};
    c.deep.verify = c.deep.verify || "Use a meter with an appropriate CAT rating for the circuit. True-RMS meters are needed when measuring non-sinusoidal waveforms (many VFD outputs and electronic loads).";
  }
  if (byId["rms"] || byId["true-rms"]) {
    const c = byId["rms"] || byId["true-rms"];
    if (c) {
      c.deep = c.deep || {};
      c.deep.recognize = c.deep.recognize || "RMS is the effective value of an AC quantity. Average-responding meters can misread non-sinusoidal waveforms; true-RMS meters are preferred around VFDs and electronic loads.";
    }
  }
  if (byId["vfd"]) {
    const c = byId["vfd"];
    c.deep = c.deep || {};
    if (!/DC bus|stored energy|true-RMS/.test(JSON.stringify(c.deep))) {
      c.deep.verify = (c.deep.verify || "") + " DC bus capacitors can hold hazardous voltage after power is removed — follow the manufacturer's discharge/wait procedure. Output voltage is often non-sinusoidal; use appropriate meters.";
    }
  }

  // ---- Welding: fume and modern PPE framing ----
  if (byId["welding-ppe"] || byId["fume-control"]) {
    const c = byId["welding-ppe"] || byId["fume-control"];
    c.deep = c.deep || {};
    c.deep.recognize = c.deep.recognize || "PPE is a system: helmet/shade, gloves, clothing, and respiratory/fume control as required by the process and base metal (including coatings).";
    c.deep.verify = c.deep.verify || "Hexavalent chromium and other fumes from certain stainless and coated materials need specific controls. Local exhaust at the source is preferred when practical.";
  }

  console.log("V13 modernity overlay applied");
})();
